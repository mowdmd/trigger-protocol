{
  "name": "trigger-mcp-proxy",
  "version": "0.2.0",
  "description": "A stdio MCP proxy with schema validation and optional local trust enforcement.",
  "type": "module",
  "bin": {
    "trigger-mcp-proxy": "./bin/trigger-mcp-proxy.mjs",
    "trigger-receipt": "./bin/trigger-receipt.mjs"
  },
  "scripts": {
    "test": "npm run test:schema && node mcp-proxy/test.mjs && node mcp-proxy/test-signature.mjs && node --test mcp-proxy/test-hardening.mjs",
    "test:schema": "node mcp-proxy/test-schema.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mowdmd/trigger-protocol.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "authorization",
    "trigger-protocol",
    "proxy",
    "protocol",
    "signed-receipts",
    "ed25519"
  ],
  "files": [
    "bin",
    "mcp-proxy/index.mjs",
    "mcp-proxy/trust.mjs",
    "mcp-proxy/README.md",
    "protocol/*.mjs",
    "protocol/*.json",
    "protocol/*.md",
    "protocol/*.py",
    "examples",
    "README.md",
    "MCP_PROXY.md",
    "THREAT_MODEL.md",
    "LICENSE"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
