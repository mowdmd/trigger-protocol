{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://trigger-protocol.org/schema/trigger-receipt-0.3.json",
  "title":"Trigger Receipt v0.3",
  "description":"Portable authorization record for a bounded action with optional Ed25519 signature.",
  "type":"object",
  "required":["id","protocol","proposal_id","decision_id","proposal_hash","actor","authority_id","action","issued_at"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "protocol":{"const":"trigger/0.3"},
    "proposal_id":{"type":"string","minLength":1},
    "decision_id":{"type":"string","minLength":1},
    "proposal_hash":{"type":"string","minLength":1},
    "actor":{"type":"string","minLength":1},
    "authority_id":{"type":"string","minLength":1},
    "action":{"type":"string","minLength":1},
    "scope":{"oneOf":[{"type":"string","minLength":1},{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}]},
    "issued_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "nonce":{"type":"string","minLength":1},
    "constraints":{"type":"object"},
    "policy_version":{"type":"string"},
    "revoked":{"type":"boolean"},
    "extensions":{"type":"object"},
    "signature":{"$ref":"trigger-receipt-signature.schema.json"}
  },
  "additionalProperties":false
}